{
  "name": "simple-poe-check",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight Path of Exile price checker and hideout hotkey overlay",
  "main": "dist-main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "node scripts/build-main.mjs --watch",
    "build:renderer": "vue-tsc --noEmit && vite build",
    "build:main": "tsc --noEmit -p tsconfig.main.json && node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "test": "node scripts/run-tests.mjs",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-overlay-window": "^4.1.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "com.simplepoecheck.app",
    "productName": "Simple PoE Check",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
